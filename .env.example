# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings > API). Na Vercel, cadastre estas
# duas variáveis em Settings > Environment Variables com os mesmos nomes.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da Places API (New), do Google Cloud Console. NÃO leva o
# prefixo NEXT_PUBLIC_ de propósito: só o servidor lê essa variável,
# ela nunca é enviada ao navegador. Ative a "Places API (New)" no
# projeto do Google Cloud antes de gerar a chave.
GOOGLE_PLACES_API_KEY=
