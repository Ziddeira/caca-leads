# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings > API). Na Vercel, cadastre estas
# duas variáveis em Settings > Environment Variables com os mesmos nomes.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da Places API (New), do Google Cloud Console. NÃO leva o
# prefixo NEXT_PUBLIC_ de propósito: só o servidor lê essa variável,
# ela nunca é enviada ao navegador. Ative a "Places API (New)" no
# projeto do Google Cloud antes de gerar a chave.
GOOGLE_PLACES_API_KEY=

# Chave "service_role" do Supabase (Project Settings > API > service_role).
# SÓ o servidor usa: é com ela que o webhook do Asaas aplica pagamentos.
# Nunca coloque o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas (pagamentos). Todas server-only.
# ASAAS_API_KEY: painel do Asaas > Integrações > Chaves de API. A chave
# começa com "$aact_"; AQUI no .env.local escreva "\$aact_..." (com a
# barra), senão o Next.js trata o "$" como variável e apaga a chave. Na
# Vercel, cole a chave normal, sem a barra.
ASAAS_API_KEY=
# "sandbox" (testes) ou "producao".
ASAAS_ENV=sandbox
# Um texto secreto que você inventa (32+ caracteres) e cadastra igual no
# painel do Asaas, no campo "Token de autenticação" do webhook.
ASAAS_WEBHOOK_TOKEN=

# Segredo das rotinas agendadas (Vercel Cron): verificação semanal das
# vendas e virada do mês do rank. Invente um texto aleatório com 32+
# caracteres e cadastre na Vercel com este nome; a Vercel envia sozinha
# em cada execução agendada. Sem ele, as rotas /api/cron/* recusam (401).
CRON_SECRET=
